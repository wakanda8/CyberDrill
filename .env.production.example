# Copy to .env.production on the server and fill in the blanks. Never commit .env.production.
# Used by compose.yaml: docker compose --env-file .env.production up -d --build

APP_NAME=CyberDrill
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://cyberdrill.hpcs.my

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# The database runs in the "db" container; compose.yaml sets DB_CONNECTION and DB_HOST.
DB_DATABASE=cyberdrill
DB_USERNAME=cyberdrill
# Use a long random password.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# From Cloudflare: Networking > Tunnels > your tunnel (the long token in the install command).
CLOUDFLARE_TUNNEL_TOKEN=
